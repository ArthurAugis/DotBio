APP_NAME=DotBio
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite needs no extra configuration; the file is created by `php artisan migrate`.
# For MySQL/PostgreSQL, switch DB_CONNECTION and fill in the credentials below.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=dotbio
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set both to true once the site is served over HTTPS.
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Discord application credentials (https://discord.com/developers/applications).
# Required for "Sign in with Discord".
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI="${APP_URL}/auth/discord/callback"

# Bot token of the same application. Required by `php artisan discord:bot`,
# which mirrors your live Discord presence onto the profile page.
DISCORD_BOT_TOKEN=

# Shared secret for POST /api/discord/update-status.
# Required to use POST /api/discord/update-status. Leave empty to keep the endpoint closed.
DISCORD_STATUS_SECRET=

VITE_APP_NAME="${APP_NAME}"
