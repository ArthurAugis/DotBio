APP_NAME=DotBio
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite needs no extra configuration; the file is created by `php artisan migrate`.
# For MySQL/PostgreSQL, switch DB_CONNECTION and fill in the credentials below.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=dotbio
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set both to true once the site is served over HTTPS.
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Use "smtp" with Resend or Brevo to send password reset emails.
MAIL_MAILER=log
MAIL_SCHEME=
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Discord application credentials (https://discord.com/developers/applications).
# Required for "Sign in with Discord".
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI="${APP_URL}/auth/discord/callback"

# Other sign in providers. A provider only shows on the login page once its
# secret is set.
# Google (https://console.cloud.google.com/apis/credentials).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# GitHub (https://github.com/settings/developers).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI="${APP_URL}/auth/github/callback"

# Twitch (https://dev.twitch.tv/console).
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI="${APP_URL}/auth/twitch/callback"

# Steam uses a Web API key instead of a client id and secret
# (https://steamcommunity.com/dev/apikey).
STEAM_CLIENT_SECRET=
STEAM_REDIRECT_URI="${APP_URL}/auth/steam/callback"

# Spotify (https://developer.spotify.com/dashboard).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI="${APP_URL}/auth/spotify/callback"

# Patreon (https://www.patreon.com/portal/registration/register-clients).
PATREON_CLIENT_ID=
PATREON_CLIENT_SECRET=
PATREON_REDIRECT_URI="${APP_URL}/auth/patreon/callback"

# Bot token of the same application. Required by `php artisan discord:bot`,
# which mirrors your live Discord presence onto the profile page.
DISCORD_BOT_TOKEN=

# Start the presence daemon from the scheduler. Leave false when systemd runs it.
DOTBIO_RUN_DISCORD_BOT=false

# Shared secret for POST /api/discord/update-status.
# Required to use POST /api/discord/update-status. Leave empty to keep the endpoint closed.
DISCORD_STATUS_SECRET=

VITE_APP_NAME="${APP_NAME}"
